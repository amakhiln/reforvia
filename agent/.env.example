# Copy to .env for local runs (never commit .env). On Render, set these in the dashboard instead.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY   # same public key the web app uses, NOT the secret/service_role key
OPENROUTER_API_KEY=sk-or-...                            # from openrouter.ai/keys; usage is billed there
ALLOWED_ORIGINS=http://localhost:3000                    # comma-separated; add your deployed web app URL
COACH_MODEL=anthropic/claude-sonnet-5.5                  # any OpenRouter model id that supports tool calling
DAILY_MESSAGE_LIMIT=30

# Weekly reviews (Phase 4)
SUPABASE_SECRET_KEY=
CRON_SECRET=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
ANALYST_TZ=Asia/Kolkata
